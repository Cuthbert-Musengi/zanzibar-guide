# AI provider: auto | ollama | openai | gemini
# auto: choose by query complexity and in-flight traffic; use Ollama if neither key is set.
AI_PROVIDER=auto

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Local development MongoDB URI. Docker Compose uses its internal MongoDB service.
MONGODB_URI=mongodb://127.0.0.1:27017/zanzibar_guide
# Optional Compose override for a secured/external MongoDB instance.
# MONGODB_URI_DOCKER=mongodb://user:password@mongo:27017/zanzibar_guide?authSource=admin

# Optional OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.6-flash

# Stripe sandbox
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin CMS keys (editor vs viewer)
ADMIN_KEY=travelguide-admin
ADMIN_VIEWER_KEY=travelguide-viewer

# Optional Mapbox
# VITE_MAPBOX_TOKEN=pk....

# WhatsApp Cloud API (optional — messaging page still works as stub without these)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=travelguide-verify
